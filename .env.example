# Copy to .env for local runs. In a container, set these as environment variables.

# Sign-in mode: "oidc" (default) or "none" (no sign-in; local use only).
AUTH_MODE=oidc

# Required when AUTH_MODE=oidc. Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Required when AUTH_MODE=oidc: any OpenID Connect provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Required when AUTH_MODE=oidc: who may sign in. Set one or both, comma-separated.
# ALLOWED_EMAILS matches the email claim; ALLOWED_GROUPS matches the "groups" claim.
ALLOWED_EMAILS=
ALLOWED_GROUPS=
# Optional. Scopes requested at sign-in. Default "openid email profile groups".
# The provider must emit a "groups" claim for ALLOWED_GROUPS to work.
OIDC_SCOPES=

# Optional. Secure cookies and HSTS. Default true with AUTH_MODE=oidc, false with none.
# Set false only for plain-HTTP local testing of sign-in.
FORCE_HTTPS=
# Optional. Default true. Set false only to fetch from a host with a private CA.
VERIFY_SSL=true
# Optional. Seconds to wait for a metadata URL. Default 10.
HTTP_TIMEOUT=10
# Optional. Largest upload or fetched document, in bytes. Default 5242880.
MAX_CONTENT_BYTES=5242880

# Optional. Local run only (python app.py). Defaults: 127.0.0.1 and 8081.
HOST=127.0.0.1
PORT=8081
# Optional. Container only: gunicorn workers. Default 1.
WEB_CONCURRENCY=1
